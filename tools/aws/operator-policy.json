{
 "Version": "2012-10-17",
 "Statement": [
  {"Sid": "CdkDeployThroughTheBootstrapRoles", "Effect": "Allow", "Action": "sts:AssumeRole",
   "Resource": "arn:aws:iam::ACCOUNT:role/cdk-hnb659fds-*-ACCOUNT-us-west-2"},
  {"Sid": "StackOutputs", "Effect": "Allow", "Action": ["cloudformation:DescribeStacks", "sts:GetCallerIdentity"],
   "Resource": "*"},
  {"Sid": "Bucket", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
   "Resource": ["arn:aws:s3:::dopplertrack-ACCOUNT-us-west-2", "arn:aws:s3:::dopplertrack-ACCOUNT-us-west-2/*"]},
  {"Sid": "LaunchJobBoxes", "Effect": "Allow",
   "Action": ["ec2:CreateFleet", "ec2:RunInstances", "ec2:CreateTags", "ec2:Describe*"], "Resource": "*",
   "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}},
  {"Sid": "OnlyThisProjectsBoxes", "Effect": "Allow",
   "Action": ["ec2:TerminateInstances", "ec2:StartInstances", "ec2:StopInstances"], "Resource": "*",
   "Condition": {"StringEquals": {"aws:ResourceTag/project": "dopplertrack"}}},
  {"Sid": "PassTheStacksRoles", "Effect": "Allow", "Action": "iam:PassRole",
   "Resource": ["arn:aws:iam::ACCOUNT:role/DopplertrackFleet-BoxRole*", "arn:aws:iam::ACCOUNT:role/DopplertrackFleet-FisRole*"]},
  {"Sid": "DevBoxCommands", "Effect": "Allow",
   "Action": ["ssm:SendCommand", "ssm:StartSession", "ssm:GetCommandInvocation", "ssm:DescribeInstanceInformation",
              "ssm:TerminateSession"], "Resource": "*"},
  {"Sid": "Interruptions", "Effect": "Allow",
   "Action": ["fis:CreateExperimentTemplate", "fis:StartExperiment", "fis:GetExperiment", "fis:TagResource"],
   "Resource": "*"},
  {"Sid": "Prices", "Effect": "Allow", "Action": ["pricing:GetProducts", "ec2:DescribeSpotPriceHistory"], "Resource": "*"}
 ]
}
